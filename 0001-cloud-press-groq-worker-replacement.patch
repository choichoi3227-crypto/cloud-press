+
+function parseGoogle(html) {
+  const results = [];
+  const blocks = html.match(/<div class="g[\s\S]*?(?=<div class="g|<\/body>)/g) || [];
+  for (const block of blocks) {
+    const href = block.match(/href="([^"]+)"/)?.[1];
+    const title = decodeHtml(block.match(/<h3[^>]*>([\s\S]*?)<\/h3>/)?.[1]);
