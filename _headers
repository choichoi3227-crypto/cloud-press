# CloudPress — _headers
# Cloudflare Pages 응답 헤더 설정
# 성능: 정적 자산 immutable 캐싱, WordPress 자산 edge 캐싱
# 보안: CSP, XSS, Clickjacking 방어

# ── 전체 페이지 기본 보안 헤더 ──────────────────────────────────────────────
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-XSS-Protection: 1; mode=block
  X-DNS-Prefetch-Control: on

# ── CloudPress 대시보드 정적 자산 (영구 캐시) ────────────────────────────────
/style.css
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding

/src/*.js
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding

/chat-widget.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Vary: Accept-Encoding

/php-runner.js
  Cache-Control: public, max-age=86400
  Vary: Accept-Encoding

# ── 파비콘 / 아이콘 ─────────────────────────────────────────────────────────
/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/favicon-*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# ── WordPress 코어 정적 자산 (Cloudflare Pages에서 프록시할 경우) ─────────────
/wp-includes/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding
  X-Source: wp-core-cdn

/wp-admin/css/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding

/wp-admin/js/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding

/wp-admin/images/*
  Cache-Control: public, max-age=31536000, immutable

# ── WordPress 사용자 콘텐츠 (GitHub 미러) ─────────────────────────────────────
/wp-content/themes/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding
  X-Source: github-mirror

/wp-content/plugins/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding
  X-Source: github-mirror

/wp-content/uploads/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Source: github-mirror

# ── HTML 페이지 (인증 필요 — 캐시 없음) ──────────────────────────────────────
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  X-Frame-Options: SAMEORIGIN

/dashboard.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY

/account.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY

/admin.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY

/admin-*.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY

/hosting.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow

/hosting-*.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow

/editor.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY

/traffic.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow

/storage.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow

/dns.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow

/domains.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow

/payment.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow

/payment-success.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow

# ── 공개 페이지 (단기 캐시) ──────────────────────────────────────────────────
/index.html
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
  X-Frame-Options: SAMEORIGIN

/pricing.html
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/features.html
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/about.html
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/contact.html
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/faq.html
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# ── API 엔드포인트 (캐시 없음) ────────────────────────────────────────────────
/api/*
  Cache-Control: no-cache, no-store, must-revalidate

/functions/*
  Cache-Control: no-cache, no-store, must-revalidate

# ── WordPress API ─────────────────────────────────────────────────────────────
/wp-json/*
  Cache-Control: no-cache, no-store, must-revalidate
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, PUT, DELETE, PATCH, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization, X-Requested-With, X-WP-Nonce

# ── WordPress 관리자 (절대 캐시 없음) ─────────────────────────────────────────
/wp-admin/*
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: SAMEORIGIN

/wp-login.php
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow

# ── 사이트맵 ─────────────────────────────────────────────────────────────────
/sitemap.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Content-Type: application/xml; charset=utf-8
