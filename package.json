{
  "name": "cloud-press",
  "version": "5.0.0",
  "description": "서버리스 WordPress 호스팅 — WordPress→Astro SSR 자동 변환 + Cloudflare Workers 순수 미러링 + GitHub SQLite DB",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute cloudpress-db --file=schema.sql",
    "db:migrate": "wrangler d1 execute cloudpress-db --file=schema-migrate.sql",
    "db:remote": "wrangler d1 execute cloudpress-db --remote --file=schema.sql",
    "logs": "wrangler tail",
    "setup": "node setup.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
