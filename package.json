{
  "name": "cloud-press",
  "version": "4.0.0",
  "description": "서버리스 WordPress 호스팅 — php-wasm + Cloudflare Pages + GitHub 미러링",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:php": "wrangler dev --config wrangler-php.toml --port 8789",
    "deploy": "npm run deploy:php && npm run deploy:main",
    "deploy:main": "wrangler deploy",
    "deploy:php": "wrangler deploy --config wrangler-php.toml",
    "db:init": "wrangler d1 execute cloudpress-db --file=schema.sql",
    "db:migrate": "wrangler d1 execute cloudpress-db --file=schema-migrate.sql",
    "db:remote": "wrangler d1 execute cloudpress-db --remote --file=schema.sql",
    "logs": "wrangler tail",
    "logs:php": "wrangler tail --name cloudpress-php",
    "setup": "node setup.mjs",
    "cache:clear": "wrangler kv:key delete --binding=CACHE --all 2>/dev/null || true"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@php-wasm/web": "^0.9.27"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
